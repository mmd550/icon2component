{
  "name": "@weblite/icon-cli",
  "version": "1.0.7",
  "description": "A simple cli for converting svg icons to mui compatible components",
  "main": "./dist/src/main.js",
  "bin": {
    "iconlite": "./dist/src/index.js"
  },
  "scripts": {
    "make": "node ./dist/src/index.js make --keep-colors --camel-case-attrs --out-dir icons -- svgs",
    "prebuild": "rimraf ./dist/ ./exec/",
    "build": "tsc",
    "prepub": "npm run build",
    "pub": "npm publish"
  },
  "publishConfig": {
    "@weblite:registry": "https://git.weblite.me/api/v4/projects/207/packages/npm/"
  },
  "author": "Mohammad Farvardin",
  "license": "ISC",
  "dependencies": {
    "change-case": "^4.1.2",
    "prettier": "^3.0.3",
    "svgo": "^3.0.2",
    "svgson": "^5.3.1",
    "yargs": "^17.7.2"
  },
  "files": [
    "dist/**/*"
  ],
  "devDependencies": {
    "@types/node": "^20.6.1",
    "@types/prettier": "^3.0.0",
    "@types/yargs": "^17.0.24",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
