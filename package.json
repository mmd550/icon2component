{
  "name": "@weblite/icon-cli",
  "version": "1.0.1",
  "description": "A simple cli for converting svg icons to mui compatible components",
  "source": "src/index.ts",
  "main": "bin/main.js",
  "module": "bin/module.js",
  "types": "bin/types.d.ts",
  "bin": {
    "iconlite": "./bin/main.js"
  },
  "scripts": {
    "build": "parcel build",
    "make": "node ./bin/main.js make --keep-colors --out-dir icons -- svgs",
    "pub": "npm publish"
  },
  "publishConfig": {
    "@weblite:registry": "https://git.weblite.me/api/v4/projects/207/packages/npm/"
  },
  "author": "Mohammad Farvardin",
  "license": "ISC",
  "dependencies": {
    "change-case": "^4.1.2",
    "prettier": "^3.0.3",
    "svgo": "^3.0.2",
    "svgson": "^5.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.9.3",
    "@parcel/transformer-typescript-types": "^2.9.3",
    "@types/node": "^20.6.1",
    "@types/prettier": "^3.0.0",
    "@types/yargs": "^17.0.24",
    "parcel": "^2.9.3",
    "typescript": "^5.2.2"
  }
}
