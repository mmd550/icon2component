{
  "name": "icon2component",
  "version": "1.2.0",
  "description": "A simple cli for converting svg icons to react components",
  "main": "./dist/src/main.js",
  "bin": {
    "icon2component": "./dist/src/index.js"
  },
  "scripts": {
    "prebuild": "rimraf ./dist/ ./exec/",
    "build": "tsc",
    "pretest": "yarn build",
    "prepub": "npm run build",
    "pub": "npm publish",
    "test": "node ./dist/src/index.js make --keep-colors --camel-case-attrs --out-dir icons -- svgs"
  },
  "license": "ISC",
  "author": "Mohammad Farvardin",
  "dependencies": {
    "change-case": "^4.1.2",
    "prettier": "^3.0.3",
    "svgo": "^3.0.2",
    "svgson": "^5.3.1",
    "yargs": "^17.7.2"
  },
  "files": [
    "dist/**/*"
  ],
  "repository":{
    "type": "git",
    "url": "https://github.com/mmd550/icon2component"
  },
  "keywords": [
    "svg",
    "icon",
    "react",
    "mui",
    "component",
    "generator"
  ],
  "devDependencies": {
    "@types/node": "^20.6.1",
    "@types/prettier": "^3.0.0",
    "@types/yargs": "^17.0.24",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
